# Server
PORT=4000
NODE_ENV=development

# Postgres (Sequelize). Local dev default shown; swap for a Neon connection string in production.
DATABASE_URL=postgres://localhost:5432/precedent_dev
TEST_DATABASE_URL=postgres://localhost:5432/precedent_test

# CORS — comma-separated list of frontend origins allowed to call this API
# (Vite falls back to 5174+ if 5173 is already taken by another local project)
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:5174

# Auth0 (API/resource server side)
# Create an Auth0 "API" (not just an application) to get an audience identifier, and an
# Auth0 application (SPA) on the frontend that requests access tokens for that audience.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://precedent.api

# DEV/TEST ONLY — when true, auth middleware skips real Auth0 JWT verification and treats
# every request as AUTH_BYPASS_USER_ID. Never set this to true in production.
AUTH_BYPASS=false
AUTH_BYPASS_USER_ID=dev-user

# LLM provider (currently Gemini) — server-side only, never sent to the client
AI_API_KEY=your-api-key-here
# Swap for another Gemini model if you want cheaper/faster demo calls.
AI_MODEL=gemini-3.7-flash

# Seed script — which userId (Auth0 sub, or AUTH_BYPASS_USER_ID for local dev) to attach seed data to
SEED_USER_ID=dev-user
