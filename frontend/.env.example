# Auth0 SPA application (create one in your Auth0 tenant, "Single Page Application" type)
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-auth0-spa-client-id
# Must match the AUTH0_AUDIENCE the backend expects (an Auth0 "API" identifier)
VITE_AUTH0_AUDIENCE=https://precedent.api

# Base URL of the backend API
VITE_API_BASE_URL=http://localhost:4000/api
